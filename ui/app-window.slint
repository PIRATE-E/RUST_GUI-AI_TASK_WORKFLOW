// =============================================================================
// FILE: ui/app-window.slint
// PURPOSE: Main application window composing the Header, Scrollable Chat Feed,
//          Input Dock, 75% Slide-In TicketDrawer, and Boot/Error Overlays.
// =============================================================================

import { Button, LineEdit, ListView } from "std-widgets.slint";
import { AppState, ChatMessage, DrawerLogItem } from "types.slint";
import { ChatBubble } from "chat-bubble.slint";
import { TicketDrawer } from "ticket-drawer.slint";

// Re-export shared types so `slint::include_modules!()` generates Rust structs
export { AppState, ChatMessage, DrawerLogItem }
export component AppWindow inherits Window {
    title: "Cold Wind AI • Workflow & Telemetry Console";
    min-width: 540px;
    min-height: 500px;
    preferred-width: 760px;
    preferred-height: 640px;
    background: #090d16; // Deep Obsidian Canvas

    // =========================================================================
    // SLINT <-> RUST DATA CONTRACT
    // =========================================================================
    in-out property <AppState> app-state: AppState.Booting;
    in property <string> boot-status: "Initializing Cold Wind AI Core...";
    in property <string> boot-error: "";

    // 1. Main Chat Message Feed (Populated & Mutated In-Place via Rust VecModel)
    in property <[ChatMessage]> messages: [
        {
            ticket-id: "slint-0000",
            text: "Cold Wind AI Telemetry Console is online. Send a prompt to start a live workflow turn.",
            is-user: false,
            sender: "ColdWind AI",
            timestamp: "Ready",
            is-generating: false,
            task-progress: "Task [1/1]",
            rpm-count: 0,
            api-count: 1,
            fail-count: 0,
            live-summary: "System Initialized"
        }
    ];

    // 2. 75% Ticket Drawer State (Synced by Rust on `inspect-ticket` & live logs)
    in-out property <bool> drawer-open: false;
    in-out property <ChatMessage> active-ticket;
    in-out property <string> active-ticket-user-prompt: "";
    in property <[DrawerLogItem]> active-ticket-logs: [];

    // 3. Bottom Input Box Text
    in-out property <string> current-input: "";

    // 4. Callbacks to Rust
    callback send-message();
    callback inspect-ticket(string);

    // =========================================================================
    // MAIN VERTICAL WORKSPACE
    // =========================================================================
    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        // Top Header Bar
        Rectangle {
            vertical-stretch: 0;
            height: 44px;
            background: #111827;
            border-radius: 10px;
            border-width: 1px;
            border-color: #1f2937;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000066;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #10b981;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "COLD WIND AI  •  AGENT HARNESS";
                        color: #f8fafc;
                        font-size: 12.5px;
                        font-weight: 700;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "PyO3 + Slint Live Telemetry";
                    color: #64748b;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        // Center Scrollable Chat Feed
        ListView {
            vertical-stretch: 1;

            for msg[idx] in root.messages: HorizontalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                padding-left: 6px;
                padding-right: 6px;
                alignment: msg.is-user ? end : start;

                ChatBubble {
                    msg: msg;
                    inspect-ticket(id) => {
                        root.active-ticket = msg;
                        if idx > 0 && root.messages[idx - 1].is-user {
                            root.active-ticket-user-prompt = root.messages[idx - 1].text;
                        }
                        root.drawer-open = true;
                        root.inspect-ticket(id);
                    }
                }
            }
        }

        // Bottom Input Dock
        Rectangle {
            vertical-stretch: 0;
            height: 52px;
            background: #111827;
            border-radius: 10px;
            border-width: 1px;
            border-color: #1f2937;

            HorizontalLayout {
                padding: 6px;
                spacing: 8px;

                input-box := LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.current-input;
                    placeholder-text: "Ask Cold Wind AI or run a workflow...";
                    accepted => {
                        root.send-message();
                    }
                }

                send-btn := Button {
                    text: "Send";
                    primary: true;
                    width: 86px;
                    clicked => {
                        root.send-message();
                    }
                }
            }
        }
    }

    // =========================================================================
    // SLIDE-OVER OVERLAY: 75% Ticket Telemetry Drawer
    // =========================================================================
    TicketDrawer {
        is-open: root.drawer-open;
        active-ticket: root.active-ticket;
        user-prompt: root.active-ticket-user-prompt;
        logs: root.active-ticket-logs;
        close-drawer => {
            root.drawer-open = false;
        }
    }

    // =========================================================================
    // LIFECYCLE OVERLAYS: Booting Splash & Fatal Error Screen
    // =========================================================================
    if root.app-state == AppState.Booting: Rectangle {
        background: #090d16;
        width: 100%;
        height: 100%;

        VerticalLayout {
            alignment: center;
            spacing: 14px;

            Text {
                text: "COLD WIND AI";
                font-size: 26px;
                font-weight: 700;
                letter-spacing: 1.5px;
                color: #6366f1;
                horizontal-alignment: center;
            }

            Text {
                text: root.boot-status;
                font-size: 13px;
                color: #94a3b8;
                horizontal-alignment: center;
            }
        }
    }

    if root.app-state == AppState.Failed: Rectangle {
        background: #14090c;
        width: 100%;
        height: 100%;

        VerticalLayout {
            alignment: center;
            spacing: 14px;
            padding-left: 28px;
            padding-right: 28px;

            Text {
                text: "CORE BOOT FAILED";
                font-size: 20px;
                font-weight: 700;
                color: #ef4444;
                horizontal-alignment: center;
            }

            Text {
                text: root.boot-error;
                font-size: 13px;
                color: #fecaca;
                horizontal-alignment: center;
                wrap: TextWrap.word-wrap;
            }
        }
    }
}
